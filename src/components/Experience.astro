---
import Section from "./Section.astro";
import { experience, earlierRoles } from "../data/resume";
---

<Section id="experience" index="02" eyebrow="Track record" title="Experience">
  <ol class="relative border-l border-[var(--color-border)]">
    {
      experience.map((job) => (
        <li class="reveal mb-12 ml-6 last:mb-0">
          <span
            class="absolute -left-[7px] mt-1.5 h-3.5 w-3.5 rounded-full border-2 border-[var(--color-accent)] bg-[var(--color-bg)]"
            aria-hidden="true"
          />
          <div class="flex flex-wrap items-baseline justify-between gap-x-4">
            <h3 class="text-lg font-semibold text-[var(--color-fg)]">
              {job.role}
              <span class="text-[var(--color-accent)]"> · {job.company}</span>
            </h3>
            <span class="font-mono text-sm text-[var(--color-faint)]">
              {job.start} — {job.end}
            </span>
          </div>
          {job.location && (
            <p class="mt-0.5 text-sm text-[var(--color-faint)]">{job.location}</p>
          )}
          <p class="mt-3 text-[var(--color-muted)]">{job.summary}</p>
          <ul class="mt-4 space-y-2">
            {job.highlights.map((h) => (
              <li class="flex gap-3 text-sm text-[var(--color-muted)]">
                <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-[var(--color-accent)]" />
                <span class="leading-relaxed">{h}</span>
              </li>
            ))}
          </ul>
          {job.stack && (
            <div class="mt-4 flex flex-wrap gap-2">
              {job.stack.map((t) => (
                <span class="rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-faint)]">
                  {t}
                </span>
              ))}
            </div>
          )}
        </li>
      ))
    }
  </ol>

  {
    earlierRoles.length > 0 && (
      <div class="reveal mt-12">
        <h3 class="mb-4 font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-faint)]">
          Earlier
        </h3>
        <ul class="divide-y divide-[var(--color-border-soft)] border-y border-[var(--color-border-soft)]">
          {earlierRoles.map((r) => (
            <li class="flex flex-wrap items-baseline justify-between gap-x-4 py-3">
              <span class="text-[var(--color-fg)]">
                {r.role}
                <span class="text-[var(--color-muted)]"> · {r.company}</span>
              </span>
              <span class="font-mono text-sm text-[var(--color-faint)]">
                {r.period}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Section>
