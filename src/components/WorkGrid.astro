---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { work } from "../data/work";

const statusLabel: Record<(typeof work)[number]["status"], string> = {
  live: "Live",
  "in-development": "In development",
  "coming-soon": "Coming soon",
};
---

<Section id="work" index="02" eyebrow="Selected work" title="Things I've Built">
  <div class="grid gap-6 sm:grid-cols-2">
    {
      work.map((p) => (
        <button
          type="button"
          data-work-trigger={p.slug}
          class="reveal group flex flex-col overflow-hidden rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] text-left transition-colors hover:border-[var(--color-accent-soft)]"
        >
          <div class="relative aspect-[16/10] w-full overflow-hidden border-b border-[var(--color-border)] bg-[var(--color-bg-soft)]">
            <img
              src={p.images[0]}
              alt={`${p.name} preview`}
              loading="lazy"
              class:list={[
                "h-full w-full transition-transform duration-300 group-hover:scale-[1.03]",
                p.thumbFit === "contain"
                  ? "object-contain p-8"
                  : "object-cover",
              ]}
            />
            <span
              class:list={[
                "absolute right-3 top-3 rounded-full border px-2.5 py-1 font-mono text-[0.65rem] uppercase tracking-wide backdrop-blur",
                p.status === "live"
                  ? "border-[var(--color-accent-soft)] bg-[var(--color-accent-dim)] text-[var(--color-accent)]"
                  : "border-[var(--color-border)] bg-[var(--color-bg)]/80 text-[var(--color-faint)]",
              ]}
            >
              {statusLabel[p.status]}
            </span>
          </div>

          <div class="flex flex-1 flex-col p-6">
            <h3 class="text-lg font-semibold text-[var(--color-fg)]">
              {p.name}
            </h3>
            <p class="mt-1 font-mono text-sm text-[var(--color-accent)]">
              {p.tagline}
            </p>
            <p class="mt-3 flex-1 leading-relaxed text-[var(--color-muted)]">
              {p.description}
            </p>
            <div class="mt-5 flex flex-wrap items-center gap-2">
              {p.stack.map((t) => (
                <span class="rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-faint)]">
                  {t}
                </span>
              ))}
            </div>
            <div class="mt-5 flex items-center gap-4">
              {p.url && (
                <span class="inline-flex items-center gap-1.5 text-sm text-[var(--color-muted)] transition-colors group-hover:text-[var(--color-accent)]">
                  <Icon name="external" class="h-4 w-4" />
                  Live site
                </span>
              )}
            </div>
          </div>
        </button>
      ))
    }
  </div>
</Section>

<!-- Shared detail overlay, populated by JS on card click -->
<div
  id="work-overlay"
  class="work-overlay hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Project details"
>
  <div class="work-modal">
    <button
      type="button"
      id="work-modal-close"
      aria-label="Close"
      class="work-modal-close"
    >
      <Icon name="close" class="h-5 w-5" />
    </button>
    <img id="work-modal-image" class="work-modal-image" alt="" />
    <div class="work-modal-body">
      <div class="work-modal-header">
        <h3 id="work-modal-name" class="text-xl font-semibold text-[var(--color-fg)]" />
        <span id="work-modal-status" class="work-modal-status" />
      </div>
      <p id="work-modal-tagline" class="mt-1 font-mono text-sm text-[var(--color-accent)]" />
      <p id="work-modal-description" class="mt-4 leading-relaxed text-[var(--color-muted)]" />
      <div id="work-modal-stack" class="mt-5 flex flex-wrap gap-2" />
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <a
          id="work-modal-url"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center gap-2 rounded-md bg-[var(--color-accent)] px-4 py-2 text-sm font-medium text-[var(--color-bg)] transition-transform hover:-translate-y-0.5"
        >
          <Icon name="external" class="h-4 w-4" />
          Visit live site
        </a>
      </div>
    </div>
  </div>
</div>

<script type="application/json" id="work-data" set:html={JSON.stringify(work)} />

<style>
  .work-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 9, 14, 0.75);
    backdrop-filter: blur(4px);
    padding: 1.25rem;
  }
  .work-overlay.hidden {
    display: none;
  }
  .work-modal {
    position: relative;
    width: 100%;
    max-width: 40rem;
    max-height: 90vh;
    overflow-y: auto;
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    box-shadow: var(--shadow-glow);
  }
  .work-modal-close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 1;
    display: flex;
    height: 2.25rem;
    width: 2.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-muted);
    border: 1px solid var(--color-border);
  }
  .work-modal-close:hover {
    color: var(--color-accent);
    border-color: var(--color-accent-soft);
  }
  .work-modal-image {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg-soft);
  }
  .work-modal-image.is-contain {
    object-fit: contain;
    padding: 2.5rem;
  }
  .work-modal-body {
    padding: 1.75rem;
  }
  .work-modal-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    justify-content: space-between;
  }
  .work-modal-status {
    border-radius: 999px;
    border: 1px solid var(--color-border);
    padding: 0.25rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-faint);
    white-space: nowrap;
  }
  .work-modal-status.is-live {
    border-color: var(--color-accent-soft);
    background: var(--color-accent-dim);
    color: var(--color-accent);
  }
</style>

<script is:inline>
  (() => {
    const overlay = document.getElementById("work-overlay");
    const dataEl = document.getElementById("work-data");
    if (!overlay || !dataEl) return;

    const work = JSON.parse(dataEl.textContent || "[]");
    const statusLabel = {
      live: "Live",
      "in-development": "In development",
      "coming-soon": "Coming soon",
    };

    const image = document.getElementById("work-modal-image");
    const name = document.getElementById("work-modal-name");
    const status = document.getElementById("work-modal-status");
    const tagline = document.getElementById("work-modal-tagline");
    const description = document.getElementById("work-modal-description");
    const stack = document.getElementById("work-modal-stack");
    const urlLink = document.getElementById("work-modal-url");
    const closeBtn = document.getElementById("work-modal-close");

    function openWork(slug) {
      const p = work.find((w) => w.slug === slug);
      if (!p) return;

      image.src = p.images[0] || "";
      image.alt = `${p.name} preview`;
      image.classList.toggle("is-contain", p.thumbFit === "contain");
      name.textContent = p.name;
      status.textContent = statusLabel[p.status] || p.status;
      status.classList.toggle("is-live", p.status === "live");
      tagline.textContent = p.tagline;
      description.textContent = p.description;

      stack.innerHTML = "";
      for (const t of p.stack) {
        const span = document.createElement("span");
        span.className =
          "rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-faint)]";
        span.textContent = t;
        stack.appendChild(span);
      }

      if (p.url) {
        urlLink.href = p.url;
        urlLink.classList.remove("hidden");
        urlLink.classList.add("inline-flex");
      } else {
        urlLink.classList.add("hidden");
        urlLink.classList.remove("inline-flex");
      }

      overlay.classList.remove("hidden");
    }

    function closeWork() {
      overlay.classList.add("hidden");
    }

    document.querySelectorAll("[data-work-trigger]").forEach((el) => {
      el.addEventListener("click", () =>
        openWork(el.getAttribute("data-work-trigger")),
      );
    });

    closeBtn.addEventListener("click", closeWork);
    overlay.addEventListener("click", (e) => {
      if (e.target === overlay) closeWork();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !overlay.classList.contains("hidden")) {
        closeWork();
      }
    });
  })();
</script>
