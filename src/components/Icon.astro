---
/** Inline SVG icons. Pass `name` + optional `class`. Stroke-based, 24x24. */
interface Props {
  name:
    | "github"
    | "linkedin"
    | "twitter"
    | "bluesky"
    | "mail"
    | "file"
    | "arrow"
    | "external"
    | "star"
    | "spark";
  class?: string;
}
const { name, class: cls = "h-5 w-5" } = Astro.props;

const paths: Record<string, string> = {
