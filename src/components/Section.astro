---
/** Consistent section wrapper: anchor id, numbered eyebrow, heading. */
interface Props {
  id: string;
  index: string; // "01"
  eyebrow: string;
  title: string;
}
const { id, index, eyebrow, title } = Astro.props;
---

<section id={id} class="mx-auto max-w-5xl px-6 py-20 sm:py-28">
  <div class="reveal">
    <div class="mb-3 flex items-center gap-3">
      <span class="font-mono text-sm text-[var(--color-accent)]">{index}</span>
      <span
        class="font-mono text-xs uppercase tracking-[0.2em] text-[var(--color-faint)]"
        >{eyebrow}</span
      >
      <span class="h-px flex-1 bg-[var(--color-border)]"></span>
    </div>
    <h2 class="mb-10 text-2xl font-semibold tracking-tight sm:text-3xl">
      {title}
    </h2>
  </div>
  <slot />
</section>
