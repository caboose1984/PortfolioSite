---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { projects } from "../data/resume";
---

<Section id="engineering-highlights" index="03" eyebrow="Platform work" title="Engineering Highlights">
  <div class="space-y-5">
    {
      projects.map((p) => (
        <div class="reveal group rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] p-6 transition-colors hover:border-[var(--color-accent-soft)] sm:p-8">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-lg font-semibold text-[var(--color-fg)]">
              {p.name}
            </h3>
            <p class="font-mono text-sm text-[var(--color-accent)]">
              {p.tagline}
            </p>
          </div>
          <p class="mt-3 max-w-2xl leading-relaxed text-[var(--color-muted)]">
            {p.description}
          </p>
          <div class="mt-5 flex flex-wrap items-center gap-2">
            {p.tags.map((t) => (
              <span class="rounded border border-[var(--color-border)] px-2 py-0.5 font-mono text-xs text-[var(--color-faint)]">
                {t}
              </span>
            ))}
            <span class="flex-1" />
            {p.repo && (
              <a
                href={p.repo}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-accent)]"
              >
                <Icon name="github" class="h-4 w-4" />
                Code
              </a>
            )}
            {p.url && (
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm text-[var(--color-muted)] transition-colors hover:text-[var(--color-accent)]"
              >
                <Icon name="external" class="h-4 w-4" />
                Live
              </a>
            )}
          </div>
        </div>
      ))
    }
  </div>
</Section>
