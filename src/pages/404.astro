---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Page not found">
  <main
    class="mx-auto flex min-h-screen max-w-3xl flex-col items-center justify-center px-6 text-center"
  >
    <p class="font-mono text-7xl font-bold text-[var(--color-accent)]">404</p>
    <h1 class="mt-4 text-2xl font-semibold">This route returned no content.</h1>
    <p class="mt-3 text-[var(--color-muted)]">
      The page you're looking for doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="mt-8 inline-flex items-center gap-2 rounded-md bg-[var(--color-accent)] px-5 py-3 font-medium text-[var(--color-bg)] transition-transform hover:-translate-y-0.5"
    >
      ← Back home
    </a>
  </main>
</Layout>
